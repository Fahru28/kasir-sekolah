<div class="max-w-7xl mx-auto px-4 py-6">
  <% if flash[:import_errors].present? %>
    <div class="alert alert-warning mb-4">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div class="text-sm"><p class="font-bold">Beberapa baris gagal:</p><ul class="list-disc list-inside text-xs"><% flash[:import_errors].each do |e| %><li><%= e %></li><% end %></ul></div>
    </div>
  <% end %>
  <% if flash[:notice] %><div class="alert alert-success mb-4"><%= flash[:notice] %></div><% end %>
  <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
    <h1 class="text-2xl font-bold flex items-center gap-2"><i class="fa-solid fa-children text-primary"></i> Data Anak <span class="badge badge-ghost"><%= @students.size %></span></h1>
    <div class="flex gap-2">
      <a href="/students/import_form" class="btn btn-outline gap-2"><i class="fa-solid fa-file-excel text-success"></i> Upload Excel</a>
      <a href="/students/new" class="btn btn-primary gap-2"><i class="fa-solid fa-plus"></i> Tambah Siswa</a>
    </div>
  </div>
  <div class="card bg-base-100 shadow border border-base-200">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>ID</th><th>NIS</th><th>Nama</th><th>Kelas</th><th>Wali</th><th>WA</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% @students.each do |s| %>
              <tr class="hover">
                <td class="font-mono text-xs"><%= s.code %></td>
                <td class="text-xs"><%= s.nis %></td>
                <td><a href="/students/<%= s.id %>" class="link link-primary font-medium text-sm"><%= s.name %></a><br><span class="text-xs opacity-60"><%= s.address %></span></td>
                <td><span class="badge badge-ghost badge-sm"><%= s.class_name %></span></td>
                <td class="text-sm"><%= s.guardian_name %></td>
                <td class="text-xs font-mono"><%= s.phone %></td>
                <td><span class="badge badge-sm <%= s.active ? 'badge-success' : 'badge-ghost' %>"><%= s.active ? 'Aktif' : 'Nonaktif' %></span></td>
                <td><a href="/students/<%= s.id %>/edit" class="btn btn-ghost btn-xs">Edit</a></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
