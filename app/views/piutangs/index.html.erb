<div class="max-w-7xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold flex items-center gap-2 mb-1"><i class="fa-solid fa-hand-holding-dollar text-warning"></i> Piutang</h1>
  <p class="text-sm opacity-60 mb-6">Daftar hutang siswa yang belum lunas. Klik untuk catat pembayaran.</p>

  <div class="stats shadow border border-warning/20 w-full mb-6">
    <div class="stat">
      <div class="stat-title">Total Piutang Berjalan</div>
      <div class="stat-value text-warning text-2xl"><%= rupiah(@total_outstanding) %></div>
      <div class="stat-desc"><%= @count_outstanding %> transaksi belum lunas</div>
    </div>
  </div>

  <div class="card bg-base-100 shadow border border-base-200">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>No</th><th>Tanggal</th><th>Siswa</th><th>Total Hutang</th><th>Dibayar</th><th>Sisa</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% @piutangs.each do |s| %>
              <% _out = s.has_attribute?(:computed_outstanding) ? s.read_attribute(:computed_outstanding).to_i : s.outstanding rescue s.outstanding %>
              <% _paid = s.has_attribute?(:computed_paid) ? s.read_attribute(:computed_paid).to_i : s.debt_payments.sum(:amount) rescue s.debt_payments.sum(:amount) %>
              <tr class="hover <%= _out == 0 ? 'opacity-50' : '' %>">
                <td><a href="/sales/<%= s.id %>" class="link link-primary font-mono text-sm"><%= s.number %></a></td>
                <td class="text-sm"><%= s.sale_date %></td>
                <td class="text-sm"><%= s.display_name %><br><span class="text-xs opacity-60"><%= s.display_class %></span></td>
                <td class="text-sm"><%= rupiah(s.total_amount) %></td>
                <td class="text-sm text-success"><%= rupiah(_paid) %></td>
                <td class="font-bold text-sm <%= _out > 0 ? 'text-warning' : 'text-success' %>"><%= rupiah(_out) %></td>
                <td><span class="badge badge-sm <%= _out == 0 ? 'badge-success' : 'badge-warning' %>"><%= _out == 0 ? 'Lunas' : 'Belum Lunas' %></span></td>
                <td><a href="/sales/<%= s.id %>" class="btn btn-xs <%= _out > 0 ? 'btn-warning' : 'btn-ghost' %>"><%= _out > 0 ? 'Bayar' : 'Lihat' %></a></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @piutangs.empty? %>
        <div class="text-center py-12">
          <i class="fa-solid fa-face-smile text-3xl opacity-20"></i>
          <p class="text-sm opacity-60 mt-2">Tidak ada piutang</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
