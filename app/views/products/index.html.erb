<div class="max-w-7xl mx-auto px-4 py-6" data-controller="product-search">
  <% if flash[:import_errors].present? %>
    <div class="alert alert-warning mb-4"><i class="fa-solid fa-triangle-exclamation"></i><div class="text-sm"><p class="font-bold">Beberapa baris gagal:</p><ul class="list-disc list-inside text-xs"><% flash[:import_errors].each do |e| %><li><%= e %></li><% end %></ul></div></div>
  <% end %>
  <% if flash[:notice] %><div class="alert alert-success mb-4"><%= flash[:notice] %></div><% end %>
  <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
    <h1 class="text-2xl font-bold flex items-center gap-2"><i class="fa-solid fa-box text-primary"></i> Data Barang <span data-product-search-target="count" class="badge badge-ghost"><%= @products.size %> barang</span></h1>
    <div class="flex gap-2">
      <a href="/products/import_form" class="btn btn-outline gap-2"><i class="fa-solid fa-file-excel text-success"></i> Upload Excel</a>
      <a href="/products/new" class="btn btn-primary gap-2"><i class="fa-solid fa-plus"></i> Tambah Barang</a>
    </div>
  </div>
  <div class="flex flex-wrap gap-2 mb-3 bg-base-100 p-3 rounded-xl border border-base-200 shadow-sm">
    <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[220px] input-sm">
      <i class="fa-solid fa-magnifying-glass text-base-content/40"></i>
      <input data-product-search-target="input" data-action="input->product-search#filter" type="text" placeholder="Ketik untuk cari — kode / nama / kategori..." class="grow" />
      <button data-product-search-target="clear" data-action="click->product-search#clear" class="btn btn-ghost btn-xs btn-circle hidden">✕</button>
    </label>
    <% cats = (Product.distinct.pluck(:category).compact.sort rescue []) %>
    <select data-action="change->product-search#filter" data-product-search-target="kategori" class="select select-bordered select-sm">
      <option value="">Semua Kategori</option>
      <% cats.each do |kat| %><option value="<%= kat %>"><%= kat %></option><% end %>
    </select>
  </div>
  <div class="card bg-base-100 shadow border border-base-200">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>Kode</th><th>Nama</th><th>Kategori</th><th>Satuan</th><th class="text-right">Modal</th><th class="text-right">Jual</th><th class="text-center">Stok</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% @products.each do |p| %>
              <% _stok = p.current_stock; _low = p.low_stock?
                 _pct = p.min_stock.to_i > 0 ? [(_stok.to_f / (p.min_stock.to_i*3) * 100).clamp(0,100), 100].min : 100 %>
              <tr data-product-search-target="item" data-search="<%= "#{p.code} #{p.name} #{p.category}".downcase %>" data-kategori="<%= p.category %>" class="hover <%= _low ? 'bg-warning/5' : '' %>">
                <td class="font-mono text-xs"><%= p.code %></td>
                <td class="font-medium text-sm"><%= p.name %></td>
                <td><span class="badge badge-ghost badge-sm"><%= p.category %></span></td>
                <td class="text-xs"><%= p.unit %></td>
                <td class="text-right text-sm"><%= rupiah(p.cost_price) %></td>
                <td class="text-right font-semibold text-sm"><%= rupiah(p.selling_price) %></td>
                <td class="text-center">
                  <div class="flex flex-col items-center gap-1 min-w-[110px]">
                    <span class="font-bold text-sm <%= _stok <= 0 ? 'text-error' : _low ? 'text-warning' : '' %>"><%= _stok %> <span class="font-normal text-xs text-base-content/50">/ min <%= p.min_stock %></span></span>
                    <progress class="progress progress-sm w-20 h-1.5 <%= _stok <= 0 ? 'progress-error' : _low ? 'progress-warning' : 'progress-success' %>" value="<%= _pct %>" max="100"></progress>
                  </div>
                </td>
                <td>
                  <% if _stok <= 0 %>
                    <span class="badge badge-error badge-sm gap-1"><i class="fa-solid fa-circle-xmark text-[10px]"></i> Habis</span>
                  <% elsif _low %>
                    <span class="badge badge-warning badge-sm gap-1"><i class="fa-solid fa-triangle-exclamation text-[10px]"></i> Menipis</span>
                  <% else %>
                    <span class="badge badge-success badge-sm gap-1"><i class="fa-solid fa-circle-check text-[10px]"></i> Aman</span>
                  <% end %>
                </td>
                <td class="flex gap-1 items-center">
                  <button onclick="document.getElementById('stok-<%= p.id %>').showModal()" class="btn btn-success btn-xs gap-1"><i class="fa-solid fa-plus text-[10px]"></i> Stok</button>
                  <dialog id="stok-<%= p.id %>" class="modal">
                    <div class="modal-box max-w-md">
                      <h3 class="font-bold">Kelola Stok — <%= p.name %></h3>
                      <p class="text-xs opacity-60 mt-1">Stok sekarang: <b><%= _stok %></b> · Kode: <%= p.code %></p>
                      <div role="tablist" class="tabs tabs-boxed tabs-sm mt-4">
                        <a role="tab" class="tab tab-active" onclick="this.closest('.modal-box').querySelector('#tab-tambah-<%= p.id %>').classList.remove('hidden'); this.closest('.modal-box').querySelector('#tab-atur-<%= p.id %>').classList.add('hidden'); this.parentElement.querySelectorAll('.tab').forEach(t=>t.classList.remove('tab-active')); this.classList.add('tab-active')">Tambah</a>
                        <a role="tab" class="tab" onclick="this.closest('.modal-box').querySelector('#tab-atur-<%= p.id %>').classList.remove('hidden'); this.closest('.modal-box').querySelector('#tab-tambah-<%= p.id %>').classList.add('hidden'); this.parentElement.querySelectorAll('.tab').forEach(t=>t.classList.remove('tab-active')); this.classList.add('tab-active')">Atur jadi</a>
                      </div>
                      <div id="tab-tambah-<%= p.id %>" class="mt-3">
                        <%= form_with url: add_stock_product_path(p), method: :post, class: "space-y-3" do |f| %>
                          <label class="form-control"><span class="label-text">Jumlah tambah *</span><input type="number" name="quantity" min="1" required placeholder="mis. 10" class="input input-bordered" /></label>
                          <label class="form-control"><span class="label-text">Catatan (opsional)</span><input type="text" name="note" placeholder="mis. beli dari Toko ATK" class="input input-bordered" /></label>
                          <div class="modal-action">
                            <button type="button" onclick="this.closest('dialog').close()" class="btn btn-ghost">Batal</button>
                            <button type="submit" class="btn btn-primary gap-2"><i class="fa-solid fa-plus"></i> Tambah</button>
                          </div>
                        <% end %>
                      </div>
                      <div id="tab-atur-<%= p.id %>" class="hidden mt-3">
                        <%= form_with url: adjust_stock_product_path(p), method: :patch, class: "space-y-3" do |f| %>
                          <label class="form-control"><span class="label-text">Stok jadi *</span><input type="number" name="target_stock" min="0" required value="<%= _stok %>" class="input input-bordered" /></label>
                          <p class="text-xs opacity-60">Untuk koreksi/stok opname. Contoh: sekarang <%= _stok %>, isi jadi 50 → akan +<%= 50-_stok %> atau -<%= _stok-50 %> otomatis.</p>
                          <label class="form-control"><span class="label-text">Catatan (opsional)</span><input type="text" name="note" placeholder="mis. stok opname 2026-09-03" class="input input-bordered" /></label>
                          <div class="modal-action">
                            <button type="button" onclick="this.closest('dialog').close()" class="btn btn-ghost">Batal</button>
                            <button type="submit" class="btn btn-warning gap-2"><i class="fa-solid fa-pen"></i> Atur</button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                    <form method="dialog" class="modal-backdrop"><button>close</button></form>
                  </dialog>
                  <a href="/products/<%= p.id %>/edit" class="btn btn-ghost btn-xs">Edit</a>
                  <%= button_to product_path(p), method: :delete, form: { data: { turbo_confirm: "Hapus #{p.name}? Tidak bisa kalau masih ada penjualan/pesanan yang pakai barang ini." } }, class: "btn btn-ghost btn-xs text-error" do %><i class="fa-solid fa-trash"></i><% end %>
                </td>
              </tr>
            <% end %>
            <tr data-product-search-target="empty" class="hidden"><td colspan="9" class="text-center py-10 text-base-content/60"><i class="fa-solid fa-inbox text-3xl mb-2 block"></i>Tidak ada barang yang cocok — coba kata lain atau ganti kategori<br><button data-action="click->product-search#clear" class="link link-primary text-sm mt-1">Tampilkan semua</button></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="mt-3 flex items-start gap-2 text-xs text-base-content/50 bg-base-100 border border-base-200 rounded-lg p-3">
    <i class="fa-solid fa-circle-info mt-0.5 text-primary"></i>
    <div><b>Stok</b> = sisa yang bisa dijual &nbsp;·&nbsp; Tambah lewat tombol <b>+ Stok</b> di tiap baris (otomatis tercatat di <b>Barang Masuk</b>), berkurang otomatis tiap transaksi <b>Kasir</b>.</div>
  </div>
</div>
