<%= form_with(model: order) do |form| %>
  <% if order.errors.any? %>
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
      <h2 class="font-semibold"><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>
      <ul class="mt-1 list-disc pl-5">
        <% order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :customer_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :customer_name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= form.label :customer_class, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :customer_class, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= form.label :customer_phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :customer_phone, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= form.label :note, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :note, rows: 4, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :status, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= form.label :total_amount, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :total_amount, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mt-6">
    <%= form.submit class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
  </div>
<% end %>
