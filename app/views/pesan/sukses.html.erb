<div class="min-h-screen bg-gradient-to-b from-amber-50 to-white flex items-center justify-center px-4 py-8">
  <div class="card bg-white shadow-xl border border-amber-100 rounded-2xl max-w-lg w-full overflow-hidden">
    <div class="h-2 bg-gradient-to-r from-amber-400 to-orange-500"></div>
    <div class="card-body text-center">
      <div class="w-16 h-16 rounded-2xl bg-emerald-100 flex items-center justify-center mx-auto text-emerald-600 text-2xl mb-3"><i class="fa-solid fa-check"></i></div>
      <h1 class="text-2xl font-extrabold">Pesanan diterima!</h1>
      <p class="opacity-60 text-sm mt-1">Terima kasih, <b><%= @order.customer_name %></b> — silakan ambil di<br><b>Unit Layanan Pendidikan</b> SIT Insan Tama</p>
      <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 text-left mt-4">
        <p class="text-xs opacity-60">No. Pesanan</p>
        <p class="font-mono font-bold">#<%= @order.id %> · <%= @order.created_at.strftime("%d %b %Y %H:%M") %></p>
        <p class="text-sm mt-2"><b><%= @order.customer_name %></b><% if @order.customer_class.present? %> · Kelas <%= @order.customer_class %><% end %> <% if @order.customer_phone.present? %>· <%= @order.customer_phone %><% end %></p>
        <% if @order.note.present? %><p class="text-sm opacity-70 mt-1">Catatan: <%= @order.note %></p><% end %>
        <div class="divider my-2"></div>
        <div class="space-y-1">
          <% @order.order_items.includes(:product).each do |oi| %>
            <div class="flex justify-between text-sm">
              <span><%= oi.product.name %> × <%= oi.quantity %></span>
              <span class="font-semibold"><%= rupiah(oi.subtotal) %></span>
            </div>
          <% end %>
        </div>
        <div class="flex justify-between font-extrabold mt-3 pt-3 border-t border-amber-200">
          <span>Total</span><span class="text-orange-600"><%= rupiah(@order.total_amount) %></span>
        </div>
        <p class="mt-3 flex items-center gap-2 text-sm"><span class="badge <%= @order.status == 'Menunggu' ? 'badge-warning' : 'badge-success' %>"><%= @order.status_label %></span> <span class="text-xs opacity-60">Tunjukkan halaman ini saat ambil · Bayar di tempat</span></p>
      </div>
      <div class="flex gap-2 mt-6">
        <a href="/pesan" class="btn flex-1 bg-amber-400 hover:bg-amber-500 border-0 text-white rounded-xl">Pesan lagi</a>
        <a href="/" class="btn btn-ghost flex-1 rounded-xl">Ke Dashboard</a>
      </div>
    </div>
  </div>
</div>
