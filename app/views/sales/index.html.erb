<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold flex items-center gap-2"><i class="fa-solid fa-receipt text-primary"></i> Penjualan</h1>
    <a href="/kasir" class="btn btn-primary gap-2"><i class="fa-solid fa-plus"></i> Transaksi Baru</a>
  </div>

  <div class="card bg-base-100 shadow border border-base-200">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>No Transaksi</th><th>Tanggal</th><th>Siswa</th><th>Item</th><th>Total</th><th>Metode</th><th>Status</th><th>Keuntungan</th><th></th></tr></thead>
          <tbody>
            <% @sales.each do |s| %>
              <tr class="hover">
                <td><a href="/sales/<%= s.id %>" class="link link-primary font-mono text-sm"><%= s.number %></a></td>
                <td class="text-sm"><%= s.sale_date %></td>
                <td class="text-sm"><%= s.student.name %><br><span class="text-xs opacity-60"><%= s.student.class_name %></span></td>
                <td class="text-center"><%= s.total_items %></td>
                <td class="font-semibold text-sm"><%= rupiah(s.total_amount) %></td>
                <td><span class="badge badge-ghost badge-sm"><%= s.payment_method %></span></td>
                <td><span class="badge <%= s.status == 'Lunas' ? 'badge-success' : 'badge-warning' %> badge-sm"><%= s.status %></span></td>
                <td class="text-success text-sm"><%= rupiah(s.profit) %></td>
                <td><a href="/sales/<%= s.id %>" class="btn btn-ghost btn-xs">Detail</a></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @sales.empty? %>
        <p class="text-center py-10 opacity-60 text-sm">Belum ada penjualan</p>
      <% end %>
    </div>
  </div>
</div>
