<div class="max-w-7xl mx-auto px-4 py-6">
  <% if flash[:import_errors].present? %>
    <div class="alert alert-warning mb-4"><i class="fa-solid fa-triangle-exclamation"></i><div class="text-sm"><p class="font-bold">Beberapa baris gagal:</p><ul class="list-disc list-inside text-xs"><% flash[:import_errors].each do |e| %><li><%= e %></li><% end %></ul></div></div>
  <% end %>
  <% if flash[:notice] %><div class="alert alert-success mb-4"><%= flash[:notice] %></div><% end %>
  <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
    <h1 class="text-2xl font-bold flex items-center gap-2"><i class="fa-solid fa-truck-ramp-box text-primary"></i> Barang Masuk</h1>
    <a href="/stock_entries/import_form" class="btn btn-outline gap-2"><i class="fa-solid fa-file-excel text-success"></i> Upload Excel</a>
  </div>

  <div class="card bg-base-100 shadow border border-base-200 mb-6">
    <div class="card-body">
      <h2 class="font-bold text-sm">Catat Stok Masuk</h2>
      <%= form_with model: StockEntry.new, url: stock_entries_path, class: "grid grid-cols-1 sm:grid-cols-6 gap-3 mt-3" do |f| %>
        <%= f.text_field :number, placeholder: "No. IN-003", class: "input input-bordered input-sm" %>
        <%= f.date_field :entry_date, value: Date.current, class: "input input-bordered input-sm" %>
        <%= f.text_field :supplier, placeholder: "Supplier", class: "input input-bordered input-sm" %>
        <%= f.collection_select :product_id, @products, :id, :name, { prompt: "Pilih barang" }, class: "select select-bordered select-sm" %>
        <%= f.number_field :quantity, placeholder: "Qty", class: "input input-bordered input-sm" %>
        <button type="submit" class="btn btn-primary btn-sm gap-1"><i class="fa-solid fa-plus"></i> Simpan</button>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow border border-base-200">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>No</th><th>Tanggal</th><th>Supplier</th><th>Barang</th><th class="text-center">Jumlah</th><th>Keterangan</th><th></th></tr></thead>
          <tbody>
            <% @entries.each do |e| %>
              <tr>
                <td class="font-mono text-xs"><%= e.number %></td>
                <td class="text-sm"><%= e.entry_date %></td>
                <td class="text-sm"><%= e.supplier %></td>
                <td class="text-sm"><%= e.product.name %> <span class="text-xs opacity-50"><%= e.product.code %></span></td>
                <td class="text-center font-bold">+<%= e.quantity %></td>
                <td class="text-xs opacity-60"><%= e.note %></td>
                <td><%= button_to stock_entry_path(e), method: :delete, class: "btn btn-ghost btn-xs text-error" do %><i class="fa-solid fa-trash"></i><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @entries.empty? %><p class="text-center py-8 opacity-60 text-sm">Belum ada barang masuk</p><% end %>
    </div>
  </div>
</div>
