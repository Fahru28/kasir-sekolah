<%
  search_cols = LlamaBotRails::ScaffoldColumns.searchable_columns(attributes)
  bool_cols = LlamaBotRails::ScaffoldColumns.boolean_columns(attributes)
-%>
<% module_namespacing do -%>
# Generated by the LlamaPress scaffold templates (llama_bot_rails).
# Filtering/search/pagination behavior lives in LlamaBotRails::ScaffoldFiltering;
# customize visible records via #base_scope, table columns in the views.
class <%= controller_class_name %>Controller < ApplicationController
  include LlamaBotRails::ScaffoldFiltering

  before_action :set_<%= singular_table_name %>, only: %i[ show edit update destroy ]

  # GET <%= route_url %>
  def index
    scope = llama_filtered_scope(base_scope,
      search_columns: <%= search_cols.any? ? "%i[ #{search_cols.map(&:column_name).join(' ')} ]" : "[]" %>,
      boolean_columns: <%= bool_cols.any? ? "%i[ #{bool_cols.map(&:column_name).join(' ')} ]" : "[]" %>,
      date_column: :created_at)
    @pagy, @<%= plural_table_name %> = llama_paginate(scope.order(created_at: :desc))
  end

  # GET <%= route_url %>/1
  def show
  end

  # GET <%= route_url %>/new
  def new
    @<%= singular_table_name %> = <%= orm_class.build(class_name) %>
  end

  # GET <%= route_url %>/1/edit
  def edit
  end

  # POST <%= route_url %>
  def create
    @<%= singular_table_name %> = <%= orm_class.build(class_name, "#{singular_table_name}_params") %>

    respond_to do |format|
      if @<%= orm_instance.save %>
        format.html { llama_after_save_redirect(@<%= singular_table_name %>, notice: <%= %("#{human_name} was successfully created.") %>) }
        format.json { render :show, status: :created, location: <%= model_resource_name(prefix: "@") %> }
      else
        format.html { render :new, status: :unprocessable_entity }
        format.json { render json: @<%= singular_table_name %>.errors, status: :unprocessable_entity }
      end
    end
  end

  # PATCH/PUT <%= route_url %>/1
  def update
    respond_to do |format|
      if @<%= orm_instance.update("#{singular_table_name}_params") %>
        format.html { llama_after_save_redirect(@<%= singular_table_name %>, notice: <%= %("#{human_name} was successfully updated.") %>) }
        format.json { render :show, status: :ok, location: <%= model_resource_name(prefix: "@") %> }
      else
        format.html { render :edit, status: :unprocessable_entity }
        format.json { render json: @<%= singular_table_name %>.errors, status: :unprocessable_entity }
      end
    end
  end

  # DELETE <%= route_url %>/1
  def destroy
    @<%= orm_instance.destroy %>

    respond_to do |format|
      format.html { redirect_to <%= index_helper %>_url, notice: <%= %("#{human_name} was successfully destroyed.") %>, status: :see_other }
      format.json { head :no_content }
    end
  end

  private
    # Records visible on the index. This is the customization point for
    # authorization scoping (e.g. policy_scope(<%= class_name %>) or
    # current_user.<%= plural_table_name %>) — keep every index query
    # flowing through it.
    def base_scope
      <%= orm_class.all(class_name) %>
    end

    # Use callbacks to share common setup or constraints between actions.
    def set_<%= singular_table_name %>
      @<%= singular_table_name %> = <%= orm_class.find(class_name, "params[:id]") %>
    end

    # Only allow a list of trusted parameters through.
    def <%= "#{singular_table_name}_params" %>
      <%- if attributes_names.empty? -%>
      params.fetch(:<%= singular_table_name %>, {})
      <%- else -%>
      params.require(:<%= singular_table_name %>).permit(<%= permitted_params %>)
      <%- end -%>
    end
end
<% end -%>
