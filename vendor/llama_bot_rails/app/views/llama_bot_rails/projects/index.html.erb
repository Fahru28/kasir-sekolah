<!DOCTYPE html>
<html data-theme="light">
<head>
  <title>Projects - LlamaBotRails</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.19/dist/full.min.css" rel="stylesheet" type="text/css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <%= csrf_meta_tags %>
</head>
<body>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 p-8">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-4">
          <%= link_to llama_bot_rails.tickets_path, class: "btn btn-sm btn-outline" do %>
            <i class="fas fa-arrow-left"></i> Tickets
          <% end %>
          <h1 class="text-3xl font-bold text-gray-900">
            <i class="fas fa-folder-open text-primary"></i> Projects
          </h1>
        </div>
        <%= link_to llama_bot_rails.new_project_path, class: "btn btn-primary" do %>
          <i class="fas fa-plus"></i> New Project
        <% end %>
      </div>

      <% if @projects.any? %>
        <div class="grid gap-4">
          <% @projects.each do |project| %>
            <div class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <%= link_to llama_bot_rails.project_path(project), class: "text-xl font-semibold text-gray-900 hover:text-primary" do %>
                    <%= project.name %>
                  <% end %>
                  <% if project.description.present? %>
                    <p class="text-gray-600 mt-2"><%= truncate(project.description, length: 200) %></p>
                  <% end %>
                  <div class="flex gap-4 mt-3 text-sm text-gray-500">
                    <span><i class="fas fa-ticket"></i> <%= project.ticket_count %> tickets</span>
                    <span><i class="fas fa-check-circle text-success"></i> <%= project.completed_ticket_count %> completed</span>
                  </div>
                </div>
                <div class="flex gap-2">
                  <%= link_to llama_bot_rails.edit_project_path(project), class: "btn btn-sm btn-ghost" do %>
                    <i class="fas fa-edit"></i>
                  <% end %>
                  <%= button_to llama_bot_rails.project_path(project), method: :delete, class: "btn btn-sm btn-ghost text-error", data: { turbo_confirm: "Delete this project? Tickets will be unassigned but not deleted." } do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <i class="fas fa-folder-open text-6xl text-gray-300 mb-4"></i>
          <p class="text-gray-500 text-lg">No projects yet</p>
          <p class="text-gray-400 mt-2">Create a project to organize your tickets</p>
          <%= link_to llama_bot_rails.new_project_path, class: "btn btn-primary mt-4" do %>
            <i class="fas fa-plus"></i> Create First Project
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>
