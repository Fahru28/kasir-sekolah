<!DOCTYPE html>
<html data-theme="light">
<head>
  <title><%= request.host %> | New Release</title>
  <%= render "head" %>
</head>
<body class="bg-base-200 min-h-screen">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <%= link_to releases_path, class: "btn btn-ghost btn-sm mb-4" do %>
      <i class="fas fa-arrow-left mr-1"></i> All releases
    <% end %>
    <h1 class="text-2xl font-bold mb-6">New Release</h1>
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body">
        <%= render "form", release: @release %>
      </div>
    </div>
  </div>
</body>
</html>
