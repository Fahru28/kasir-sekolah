<div class="card bg-base-100 shadow-md cursor-grab active:cursor-grabbing" data-ticket-id="<%= ticket.id %>">
  <div class="card-body p-3">
    <h3 class="card-title text-sm line-clamp-2"><%= ticket.title %></h3>

    <% if ticket.description.present? %>
      <p class="text-xs text-base-content/70 line-clamp-2"><%= truncate(ticket.description, length: 100) %></p>
    <% end %>

    <div class="flex flex-wrap gap-1 mt-2">
      <% if ticket.ticket_type.present? %>
        <span class="badge badge-sm badge-outline"><%= ticket.ticket_type.titleize %></span>
      <% end %>
      <% if ticket.agent_result.present? %>
        <span class="badge badge-sm <%= ticket.agent_result == 'failed' ? 'badge-error' : 'badge-success' %>">
          <%= ticket.agent_result.titleize %>
        </span>
      <% end %>
    </div>

    <div class="card-actions justify-end mt-2">
      <button type="button"
              class="btn btn-xs btn-ghost copy-ticket-btn"
              title="Copy as Markdown"
              data-ticket-title="<%= escape_javascript(ticket.title) %>"
              data-ticket-description="<%= escape_javascript(ticket.description.to_s) %>"
              data-ticket-type="<%= escape_javascript(ticket.ticket_type.to_s) %>"
              data-ticket-status="<%= escape_javascript(ticket.status.to_s) %>"
              data-ticket-notes="<%= escape_javascript(ticket.notes.to_s) %>"
              data-ticket-research-notes="<%= escape_javascript(ticket.research_notes.to_s) %>"
              data-ticket-agent-notes="<%= escape_javascript(ticket.agent_notes.to_s) %>">
        <i class="fas fa-copy"></i>
      </button>
      <button type="button" class="btn btn-xs btn-ghost" onclick="openEditModal(<%= ticket.id %>)" title="Quick Edit">
        <i class="fas fa-edit"></i>
      </button>
      <%= link_to llama_bot_rails.ticket_path(ticket), class: "btn btn-xs btn-ghost", title: "View" do %>
        <i class="fas fa-eye"></i>
      <% end %>
      <%= button_to llama_bot_rails.ticket_path(ticket), method: :delete, class: "btn btn-xs btn-ghost text-error", title: "Delete", data: { turbo_confirm: "Are you sure you want to delete this ticket?" } do %>
        <i class="fas fa-trash"></i>
      <% end %>
    </div>
  </div>
</div>
