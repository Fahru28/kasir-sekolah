<!DOCTYPE html>
<html data-theme="light">
<head>
  <title>You do not have access - LlamaBotRails</title>
  <%= render "llama_bot_rails/activity_events/head" %>
</head>
<body>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center p-8">
    <div class="max-w-md w-full">
      <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <div class="mb-6">
          <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-lock text-4xl text-yellow-500"></i>
          </div>
          <%#
            This page is for people who ARE signed in but lack the permission for
            the page they asked for. Anyone who is not signed in is sent to
            llama_bot_rails.sign_in_path instead, so this must not offer to sign
            them in — that was the dead end that stranded users in the iframe.
          %>
          <h1 class="text-2xl font-bold text-gray-800 mb-2">You do not have access</h1>
          <p class="text-gray-600">
            Your account is not allowed to view this page. Ask an administrator to
            grant you access.
          </p>
        </div>

        <div class="space-y-3">
          <%= link_to llama_bot_rails.conversations_path, class: "btn btn-primary btn-block" do %>
            <i class="fas fa-envelope mr-2"></i> Go to Messages
          <% end %>

          <button onclick="history.back()" class="btn btn-ghost btn-block">
            <i class="fas fa-arrow-left mr-2"></i> Go Back
          </button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
