<!DOCTYPE html>
<html data-theme="light">
<head>
  <title>Link Expired</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.19/dist/full.min.css" rel="stylesheet" type="text/css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="text-center p-8">
    <div class="text-8xl text-gray-300 mb-6">
      <i class="fas fa-clock"></i>
    </div>
    <h1 class="text-6xl font-bold text-gray-300 mb-4">410</h1>
    <h2 class="text-2xl font-semibold text-gray-700 mb-2">Link Expired</h2>
    <p class="text-gray-500 max-w-md">
      This shared link has expired and is no longer available.
      Please contact the owner for a new link.
    </p>
  </div>
</body>
</html>
