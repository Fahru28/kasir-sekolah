<!DOCTYPE html>
<html data-theme="light">
<head>
  <title><%= request.host %> | Feedback</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%233b82f6'><path d='M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z'/></svg>">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.19/dist/full.min.css" rel="stylesheet" type="text/css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <%= csrf_meta_tags %>
  <style>
    /* Toast Notification Styles */
    @keyframes toastSlideIn {
      from { opacity: 0; transform: translateX(400px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes toastSlideOut {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(400px); }
    }
    @keyframes progressShrink {
      from { width: 100%; }
      to { width: 0%; }
    }
    .toast {
      animation: toastSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      pointer-events: auto;
    }
    .toast.exiting {
      animation: toastSlideOut 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    .toast-progress {
      animation: progressShrink linear;
    }
    .toast-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      box-shadow: 0 8px 32px rgba(16, 185, 129, 0.15);
    }
    .toast-error {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      box-shadow: 0 8px 32px rgba(239, 68, 68, 0.15);
    }
    /* Image Modal Styles */
    .image-modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.9);
      align-items: center;
      justify-content: center;
    }
    .image-modal.active {
      display: flex;
    }
    .image-modal img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
    }

    /* Filter Mode Button Active State */
    .join .btn-active {
      background-color: #3b82f6 !important;
      border-color: #3b82f6 !important;
      color: white !important;
    }

    /* Filter Panel Animation */
    [id$="-filter-panel"] {
      animation: fadeIn 0.15s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Filter Chip Styling */
    .badge.bg-blue-100 {
      background-color: #dbeafe;
      border-color: #bfdbfe;
    }

    .badge.bg-blue-100:hover {
      background-color: #bfdbfe;
    }

    /* Checkbox styling improvements */
    .checkbox-primary:checked {
      --chkbg: #3b82f6;
      --chkfg: white;
    }

    .radio-primary:checked {
      --chkbg: #3b82f6;
    }

    /* Highlight the card the user just came back from */
    @keyframes returnedCardPulse {
      0%   { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.55); }
      40%  { box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.35); }
      100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
    }
    .feedback-card.returned-here {
      animation: returnedCardPulse 2s ease-out 1;
      border-color: #3b82f6;
      transition: border-color 0.4s ease-out;
    }
    /* Anchor jumps shouldn't hide the card under the sticky navbar */
    .feedback-card { scroll-margin-top: 6rem; }
  </style>
</head>
<body>

  <!-- Image Preview Modal -->
  <div id="image-modal" class="image-modal" onclick="closeImageModal()">
    <button class="absolute top-4 right-4 text-white text-3xl hover:text-gray-300" onclick="closeImageModal()">&times;</button>
    <img id="modal-image" src="" alt="Preview">
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-6 right-6 z-50 pointer-events-none"></div>

  <!-- Status Selector Dropdown -->
  <div id="feedback-status-selector" class="feedback-dropdown fixed hidden z-[9999] bg-white rounded-lg shadow-xl border border-gray-200 py-1 min-w-[180px] max-h-[300px] overflow-y-auto">
    <div class="px-3 py-2 text-xs font-semibold text-gray-500 border-b">Select Status</div>
    <% LlamaBotRails::UserFeedback::STATUSES.each do |status| %>
      <button
        type="button"
        class="dropdown-option w-full text-left px-3 py-2 text-sm hover:bg-gray-100 flex items-center gap-2"
        data-value="<%= status %>"
        onclick="handleStatusSelect('<%= status %>', '<%= status.humanize %>')"
      >
        <i class="fas <%= feedback_status_icon(status) %> text-xs w-4"></i>
        <span class="badge badge-xs <%= feedback_status_badge_class(status) %>"><%= status.humanize %></span>
      </button>
    <% end %>
  </div>

  <!-- Type Selector Dropdown -->
  <div id="feedback-type-selector" class="feedback-dropdown fixed hidden z-[9999] bg-white rounded-lg shadow-xl border border-gray-200 py-1 min-w-[180px] max-h-[300px] overflow-y-auto">
    <div class="px-3 py-2 text-xs font-semibold text-gray-500 border-b">Select Type</div>
    <% LlamaBotRails::UserFeedback::FEEDBACK_TYPES.each do |type| %>
      <button
        type="button"
        class="dropdown-option w-full text-left px-3 py-2 text-sm hover:bg-gray-100 flex items-center gap-2"
        data-value="<%= type %>"
        onclick="handleTypeSelect('<%= type %>', '<%= type.humanize %>')"
      >
        <i class="fas <%= feedback_type_icon(type) %> text-xs w-4"></i>
        <span class="badge badge-xs <%= feedback_type_badge_class(type) %>"><%= type.humanize %></span>
      </button>
    <% end %>
  </div>

  <!-- Priority Selector Dropdown -->
  <div id="feedback-priority-selector" class="feedback-dropdown fixed hidden z-[9999] bg-white rounded-lg shadow-xl border border-gray-200 py-1 min-w-[160px]">
    <div class="px-3 py-2 text-xs font-semibold text-gray-500 border-b">Select Priority</div>
    <% [0, 1, 2, 3].each do |priority| %>
      <button
        type="button"
        class="dropdown-option w-full text-left px-3 py-2 text-sm hover:bg-gray-100 flex items-center gap-2"
        data-value="<%= priority %>"
        onclick="handlePrioritySelect(<%= priority %>, '<%= priority_label(priority) %>')"
      >
        <span class="badge badge-xs <%= priority_badge_class(priority) %>"><%= priority_label(priority) %></span>
      </button>
    <% end %>
  </div>

  <!-- Status Filter Panel -->
  <div id="status-filter-panel" class="fixed inset-0 bg-black/30 z-[9999] hidden flex items-center justify-center" onclick="closeFilterPanel('status')">
    <div class="bg-white rounded-lg shadow-2xl w-full max-w-sm mx-4" onclick="event.stopPropagation()">
      <div class="px-4 py-3 border-b flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">
          <i class="fas fa-flag mr-2 text-blue-500"></i>Status Filter
        </h3>
        <button onclick="closeFilterPanel('status')" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="p-4">
        <!-- IS / IS NOT Toggle -->
        <div class="flex items-center gap-2 mb-4">
          <span class="text-sm text-gray-600">Mode:</span>
          <div class="join">
            <button type="button" class="btn btn-xs join-item status-mode-btn" data-mode="is" onclick="setFilterMode('status', 'is')">IS</button>
            <button type="button" class="btn btn-xs join-item status-mode-btn" data-mode="is_not" onclick="setFilterMode('status', 'is_not')">IS NOT</button>
          </div>
        </div>

        <!-- Status Checkboxes -->
        <div class="space-y-2 max-h-60 overflow-y-auto">
          <% LlamaBotRails::UserFeedback::STATUSES.each do |status| %>
            <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer">
              <input type="checkbox" class="checkbox checkbox-sm checkbox-primary status-checkbox" value="<%= status %>" data-filter="status">
              <span class="badge badge-sm <%= feedback_status_badge_class(status) %>">
                <i class="fas <%= feedback_status_icon(status) %> mr-1"></i>
                <%= status.humanize %>
              </span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="px-4 py-3 border-t flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" onclick="closeFilterPanel('status')">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyFilter('status')">Apply</button>
      </div>
    </div>
  </div>

  <!-- Type Filter Panel -->
  <div id="type-filter-panel" class="fixed inset-0 bg-black/30 z-[9999] hidden flex items-center justify-center" onclick="closeFilterPanel('type')">
    <div class="bg-white rounded-lg shadow-2xl w-full max-w-sm mx-4" onclick="event.stopPropagation()">
      <div class="px-4 py-3 border-b flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">
          <i class="fas fa-tag mr-2 text-blue-500"></i>Type Filter
        </h3>
        <button onclick="closeFilterPanel('type')" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="p-4">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-sm text-gray-600">Mode:</span>
          <div class="join">
            <button type="button" class="btn btn-xs join-item type-mode-btn" data-mode="is" onclick="setFilterMode('type', 'is')">IS</button>
            <button type="button" class="btn btn-xs join-item type-mode-btn" data-mode="is_not" onclick="setFilterMode('type', 'is_not')">IS NOT</button>
          </div>
        </div>

        <div class="space-y-2 max-h-60 overflow-y-auto">
          <% LlamaBotRails::UserFeedback::FEEDBACK_TYPES.each do |type| %>
            <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer">
              <input type="checkbox" class="checkbox checkbox-sm checkbox-primary type-checkbox" value="<%= type %>" data-filter="type">
              <span class="badge badge-sm <%= feedback_type_badge_class(type) %>">
                <i class="fas <%= feedback_type_icon(type) %> mr-1"></i>
                <%= type.humanize %>
              </span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="px-4 py-3 border-t flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" onclick="closeFilterPanel('type')">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyFilter('type')">Apply</button>
      </div>
    </div>
  </div>

  <!-- Date Range Filter Panel -->
  <div id="date-filter-panel" class="fixed inset-0 bg-black/30 z-[9999] hidden flex items-center justify-center" onclick="closeFilterPanel('date')">
    <div class="bg-white rounded-lg shadow-2xl w-full max-w-sm mx-4" onclick="event.stopPropagation()">
      <div class="px-4 py-3 border-b flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">
          <i class="fas fa-calendar mr-2 text-blue-500"></i>Date Range
        </h3>
        <button onclick="closeFilterPanel('date')" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="p-4 space-y-4">
        <!-- Date Inputs -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-gray-500 mb-1 block">From</label>
            <input type="date" id="date-filter-start" class="input input-bordered input-sm w-full">
          </div>
          <div>
            <label class="text-xs text-gray-500 mb-1 block">To</label>
            <input type="date" id="date-filter-end" class="input input-bordered input-sm w-full">
          </div>
        </div>

        <!-- Quick Select Buttons -->
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn btn-outline btn-xs" onclick="setDateRange(7)">Last 7 days</button>
          <button type="button" class="btn btn-outline btn-xs" onclick="setDateRange(30)">Last 30 days</button>
          <button type="button" class="btn btn-outline btn-xs" onclick="setDateRange(90)">Last 90 days</button>
          <button type="button" class="btn btn-outline btn-xs" onclick="setDateRange(0)">All time</button>
        </div>
      </div>
      <div class="px-4 py-3 border-t flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" onclick="closeFilterPanel('date')">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyFilter('date')">Apply</button>
      </div>
    </div>
  </div>

  <!-- Submitter Filter Panel -->
  <% if @submitters.present? %>
  <div id="submitter-filter-panel" class="fixed inset-0 bg-black/30 z-[9999] hidden flex items-center justify-center" onclick="closeFilterPanel('submitter')">
    <div class="bg-white rounded-lg shadow-2xl w-full max-w-sm mx-4" onclick="event.stopPropagation()">
      <div class="px-4 py-3 border-b flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">
          <i class="fas fa-user mr-2 text-blue-500"></i>Submitter
        </h3>
        <button onclick="closeFilterPanel('submitter')" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="p-4">
        <div class="space-y-2 max-h-60 overflow-y-auto">
          <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer">
            <input type="radio" name="submitter-radio" class="radio radio-sm radio-primary" value="">
            <span class="text-sm text-gray-500">All Users</span>
          </label>
          <% @submitters.each do |user_id, user_email| %>
            <label class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer">
              <input type="radio" name="submitter-radio" class="radio radio-sm radio-primary submitter-radio" value="<%= user_id %>">
              <span class="text-sm"><%= user_email.presence || "User ##{user_id}" %></span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="px-4 py-3 border-t flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" onclick="closeFilterPanel('submitter')">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyFilter('submitter')">Apply</button>
      </div>
    </div>
  </div>
  <% end %>

  <div class="min-h-screen bg-gradient-to-br from-slate-200 to-slate-300 p-8">
    <div class="max-w-6xl mx-auto">
      <%# No page title: the Inbox tab bar above already names this page. Only
          the hint the title carried is kept. %>
      <div class="mb-4">
        <p class="text-gray-600">View and manage user feedback submissions</p>
      </div>

      <!-- Filter Controls -->
      <div class="mb-6">
        <!-- Top Row: Navigation + Add Filter Button -->
        <div class="flex items-center gap-4 flex-wrap mb-4">
          <%= link_to kanban_user_feedbacks_path, class: "btn btn-primary btn-sm" do %>
            <i class="fas fa-columns"></i> Kanban Board
          <% end %>

          <% if can?(:view_all_feedback) %>
            <%= link_to dashboard_user_feedbacks_path, class: "btn btn-outline btn-sm" do %>
              <i class="fas fa-chart-bar"></i> Dashboard
            <% end %>
          <% end %>

          <button onclick="window.location.reload()" class="btn btn-outline btn-sm">
            <i class="fas fa-sync-alt"></i> Refresh
          </button>

          <!-- Add Filter Dropdown -->
          <div class="relative">
            <button
              id="add-filter-btn"
              class="btn btn-outline btn-sm"
              onclick="toggleFilterMenu()"
            >
              <i class="fas fa-filter"></i> Add Filter
              <i class="fas fa-chevron-down text-xs ml-1"></i>
            </button>

            <!-- Filter Menu Dropdown -->
            <div id="filter-menu" class="hidden absolute top-full left-0 mt-1 bg-white rounded-lg shadow-xl border border-gray-200 py-1 min-w-[180px] z-50">
              <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 flex items-center gap-2" onclick="openFilterPanel('status')">
                <i class="fas fa-flag text-gray-500 w-4"></i> Status
              </button>
              <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 flex items-center gap-2" onclick="openFilterPanel('type')">
                <i class="fas fa-tag text-gray-500 w-4"></i> Type
              </button>
              <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 flex items-center gap-2" onclick="openFilterPanel('date')">
                <i class="fas fa-calendar text-gray-500 w-4"></i> Date Created
              </button>
              <% if @submitters.present? %>
                <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 flex items-center gap-2" onclick="openFilterPanel('submitter')">
                  <i class="fas fa-user text-gray-500 w-4"></i> Submitter
                </button>
              <% end %>
            </div>
          </div>

          <!-- Clear All Filters -->
          <button
            id="clear-filters-btn"
            class="btn btn-ghost btn-sm text-error hidden"
            onclick="clearAllFilters()"
          >
            <i class="fas fa-times"></i> Clear All
          </button>

          <% if can?(:submit_feedback) %>
            <%= link_to new_user_feedback_path, class: "btn btn-primary btn-sm ml-auto" do %>
              <i class="fas fa-plus"></i> Submit Feedback
            <% end %>
          <% end %>
        </div>

        <!-- Active Filter Chips -->
        <div id="active-filters" class="flex flex-wrap gap-2 hidden">
          <!-- Filter chips will be dynamically inserted here -->
        </div>
      </div>

      <!-- Feedback Grouped by User -->
      <% if @feedbacks_by_user.any? %>
        <% @feedbacks_by_user.each do |user_id, feedbacks| %>
          <% next if feedbacks.nil? || feedbacks.empty? %>
          <%
            user = LlamaBotRails.user_resolver&.call(user_id)
            user_email = user&.email || feedbacks.first&.user_email || "User ##{user_id}"
            is_current_user = current_llama_user && user_id == current_llama_user.id
          %>

          <!-- User Section (Collapsible) -->
          <%
            status_counts = feedbacks.group_by(&:status).transform_values(&:count)
          %>
          <div class="collapse collapse-arrow bg-white rounded-lg shadow-sm mb-4 mt-8 first:mt-0">
            <input type="checkbox" checked />
            <div class="collapse-title py-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br <%= is_current_user ? 'from-blue-500 to-blue-600' : 'from-gray-400 to-gray-500' %> flex items-center justify-center text-white font-bold">
                  <%= user_email[0].upcase %>
                </div>
                <div>
                  <h2 class="text-lg font-semibold text-gray-800">
                    <%= is_current_user ? 'Your Feedback' : user_email %>
                  </h2>
                  <p class="text-sm text-gray-500">
                    <%= feedbacks.size %> item<%= feedbacks.size == 1 ? '' : 's' %>
                    <% if status_counts.any? %>
                      <span class="text-gray-400 mx-1">—</span>
                      <% status_counts.each_with_index do |(status, count), index| %>
                        <span class="<%= feedback_status_badge_class(status).gsub('badge-', 'text-').gsub('warning', 'yellow-600').gsub('info', 'blue-500').gsub('primary', 'indigo-500').gsub('accent', 'purple-500').gsub('success', 'green-600').gsub('neutral', 'gray-500') %>"><%= count %> <%= status.humanize.downcase %></span><%= index < status_counts.size - 1 ? ', ' : '' %>
                      <% end %>
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
            <div class="collapse-content">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <% feedbacks.each do |feedback| %>
                <%
                  priority_border = case feedback.priority
                    when 3 then 'border-red-500'
                    when 2 then 'border-orange-500'
                    when 1 then 'border-yellow-500'
                    else 'border-gray-300'
                  end
                  image_attachments = feedback.attachments.select { |a| a.content_type&.start_with?('image/') }
                %>
                <div id="feedback-<%= feedback.id %>" class="feedback-card bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-lg hover:scale-[1.02] transition-all duration-200 border-2 border-gray-200 border-l-4 <%= priority_border %> flex flex-col cursor-pointer relative" onclick="window.location='<%= user_feedback_path(feedback) %>'">
                  <!-- Subtle Edit Button (top right) -->
                  <% if current_llama_user %>
                    <%= link_to edit_user_feedback_path(feedback), class: "absolute top-2 right-2 z-10 p-2 rounded-full bg-white/80 hover:bg-white text-gray-400 hover:text-gray-600 transition-all shadow-sm", onclick: "event.stopPropagation();", title: "Edit" do %>
                      <i class="fas fa-pencil text-sm"></i>
                    <% end %>
                  <% end %>

                  <% if image_attachments.any? %>
                    <div class="relative h-40 bg-gray-100 cursor-zoom-in" onclick="event.stopPropagation(); openImageModal('<%= main_app.rails_blob_path(image_attachments.first, disposition: 'inline') %>')">
                      <%= image_tag main_app.rails_blob_path(image_attachments.first, disposition: 'inline'), class: "w-full h-full object-cover", alt: "Attachment preview" %>
                      <% if image_attachments.count > 1 %>
                        <span class="absolute bottom-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded">
                          +<%= image_attachments.count - 1 %> more
                        </span>
                      <% end %>
                      <div class="absolute inset-0 bg-black/0 hover:bg-black/10 transition-colors flex items-center justify-center opacity-0 hover:opacity-100">
                        <i class="fas fa-expand text-white text-2xl drop-shadow-lg"></i>
                      </div>
                    </div>
                  <% end %>

                  <div class="p-4 flex flex-col flex-1">
                    <div class="flex items-center gap-2 mb-2 flex-wrap">
                      <%# Type Badge %>
                      <button
                        type="button"
                        class="badge badge-xs feedback-badge-clickable cursor-pointer hover:opacity-80 transition-opacity <%= feedback_type_badge_class(feedback.feedback_type) %>"
                        data-feedback-badge="<%= feedback.id %>-feedback_type"
                        onclick="event.stopPropagation(); openFeedbackDropdown(event, <%= feedback.id %>, 'type', '<%= feedback.feedback_type %>')"
                      >
                        <i class="fas <%= feedback_type_icon(feedback.feedback_type) %> mr-1"></i>
                        <span class="badge-text"><%= feedback.feedback_type.humanize %></span>
                      </button>

                      <%# Status Badge %>
                      <button
                        type="button"
                        class="badge badge-xs feedback-badge-clickable cursor-pointer hover:opacity-80 transition-opacity <%= feedback_status_badge_class(feedback.status) %>"
                        data-feedback-badge="<%= feedback.id %>-status"
                        onclick="event.stopPropagation(); openFeedbackDropdown(event, <%= feedback.id %>, 'status', '<%= feedback.status %>')"
                      >
                        <i class="fas <%= feedback_status_icon(feedback.status) %> mr-1"></i>
                        <span class="badge-text"><%= feedback.status.humanize %></span>
                      </button>

                      <%# Priority Badge %>
                      <button
                        type="button"
                        class="badge badge-xs feedback-badge-clickable cursor-pointer hover:opacity-80 transition-opacity <%= priority_badge_class(feedback.priority) %>"
                        data-feedback-badge="<%= feedback.id %>-priority"
                        onclick="event.stopPropagation(); openFeedbackDropdown(event, <%= feedback.id %>, 'priority', '<%= feedback.priority %>')"
                      >
                        <span class="badge-text"><%= priority_label(feedback.priority) %></span>
                      </button>

                      <%# Comment Count Badge %>
                      <% if feedback.comments.any? %>
                        <span class="badge badge-xs badge-ghost">
                          <i class="fas fa-comment mr-1"></i> <%= feedback.comments.size %>
                        </span>
                      <% end %>
                    </div>

                    <h3 class="text-base font-semibold text-gray-800 mb-2 line-clamp-2">
                      <%= link_to feedback.title, user_feedback_path(feedback), class: "hover:text-blue-600" %>
                    </h3>

                    <p class="text-gray-600 text-sm line-clamp-3 mb-3 flex-1">
                      <%= truncate(feedback.description, length: 150) %>
                    </p>

                    <div class="flex items-center gap-3 text-xs text-gray-500 flex-wrap">
                      <span><i class="fas fa-clock mr-1"></i> <%= feedback.created_at.strftime('%a') %> - <%= time_ago_in_words(feedback.created_at) %> ago</span>
                      <% if feedback.attachments.any? %>
                        <span><i class="fas fa-paperclip mr-1"></i> <%= feedback.attachments.count %></span>
                      <% end %>
                    </div>

                    <% if feedback.tags.any? %>
                      <div class="flex flex-wrap gap-1 mt-2">
                        <% feedback.tags.each do |tag| %>
                          <span class="badge badge-xs" style="<%= tag_style(tag) %>"><%= tag.name %></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
          <p class="text-gray-500">No feedback found</p>
          <%= link_to new_user_feedback_path, class: "btn btn-primary btn-sm mt-4" do %>
            <i class="fas fa-plus"></i> Submit Feedback
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    function filterByParam(param, value) {
      const url = new URL(window.location.href);
      if (value) {
        url.searchParams.set(param, value);
      } else {
        url.searchParams.delete(param);
      }
      window.location.href = url.toString();
    }

    // =====================================
    // FILTER STATE & COOKIE MANAGEMENT
    // =====================================

    const COOKIE_NAME = 'feedback_filters';
    const COOKIE_DAYS = 30;

    // Filter state object
    let filterState = {
      status: { mode: 'is', values: [] },
      type: { mode: 'is', values: [] },
      date: { start: null, end: null },
      user_id: null
    };

    // Cookie Utilities
    const CookieManager = {
      set(name, value, days) {
        const expires = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = `${name}=${encodeURIComponent(JSON.stringify(value))}; expires=${expires}; path=/; SameSite=Lax`;
      },

      get(name) {
        const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        if (match) {
          try {
            return JSON.parse(decodeURIComponent(match[2]));
          } catch (e) {
            return null;
          }
        }
        return null;
      },

      delete(name) {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
      }
    };

    // Initialize filters from cookies/URL on page load
    function initFilters() {
      const urlParams = new URLSearchParams(window.location.search);
      const hasUrlFilters = urlParams.has('status[]') || urlParams.has('feedback_type[]') ||
                            urlParams.has('date_start') || urlParams.has('user_id');

      if (hasUrlFilters) {
        // Load from URL (Rails array format: status[]=x)
        filterState.status.mode = urlParams.get('status_mode') || 'is';
        filterState.status.values = urlParams.getAll('status[]');
        filterState.type.mode = urlParams.get('type_mode') || 'is';
        filterState.type.values = urlParams.getAll('feedback_type[]');
        filterState.date.start = urlParams.get('date_start');
        filterState.date.end = urlParams.get('date_end');
        filterState.user_id = urlParams.get('user_id');

        // Save to cookie for persistence
        CookieManager.set(COOKIE_NAME, filterState, COOKIE_DAYS);
      } else {
        // Load from cookie
        const savedFilters = CookieManager.get(COOKIE_NAME);
        if (savedFilters) {
          filterState = { ...filterState, ...savedFilters };
          // Apply filters from cookie (redirect with params)
          if (hasActiveFilters()) {
            applyFiltersToUrl();
            return; // Will redirect
          }
        }
      }

      // Update UI to reflect current state
      updateFilterUI();
    }

    function hasActiveFilters() {
      return filterState.status.values.length > 0 ||
             filterState.type.values.length > 0 ||
             filterState.date.start ||
             filterState.date.end ||
             filterState.user_id;
    }

    // =====================================
    // FILTER PANEL MANAGEMENT
    // =====================================

    function toggleFilterMenu() {
      const menu = document.getElementById('filter-menu');
      menu.classList.toggle('hidden');
    }

    function openFilterPanel(filterType) {
      document.getElementById('filter-menu').classList.add('hidden');
      const panel = document.getElementById(`${filterType}-filter-panel`);
      if (panel) {
        panel.classList.remove('hidden');

        // Pre-populate panel with current filter state
        if (filterType === 'status') {
          document.querySelectorAll('.status-checkbox').forEach(cb => {
            cb.checked = filterState.status.values.includes(cb.value);
          });
          updateModeButtons('status', filterState.status.mode);
        } else if (filterType === 'type') {
          document.querySelectorAll('.type-checkbox').forEach(cb => {
            cb.checked = filterState.type.values.includes(cb.value);
          });
          updateModeButtons('type', filterState.type.mode);
        } else if (filterType === 'date') {
          document.getElementById('date-filter-start').value = filterState.date.start || '';
          document.getElementById('date-filter-end').value = filterState.date.end || '';
        } else if (filterType === 'submitter') {
          document.querySelectorAll('input[name="submitter-radio"]').forEach(rb => {
            rb.checked = rb.value === String(filterState.user_id || '');
          });
        }
      }
    }

    function closeFilterPanel(filterType) {
      const panel = document.getElementById(`${filterType}-filter-panel`);
      if (panel) panel.classList.add('hidden');
    }

    function setFilterMode(filterType, mode) {
      if (filterType === 'status') {
        filterState.status.mode = mode;
      } else if (filterType === 'type') {
        filterState.type.mode = mode;
      }
      updateModeButtons(filterType, mode);
    }

    function updateModeButtons(filterType, activeMode) {
      document.querySelectorAll(`.${filterType}-mode-btn`).forEach(btn => {
        if (btn.dataset.mode === activeMode) {
          btn.classList.add('btn-active', 'btn-primary');
        } else {
          btn.classList.remove('btn-active', 'btn-primary');
        }
      });
    }

    function setDateRange(days) {
      const endDate = new Date();
      const startDate = new Date();

      if (days === 0) {
        document.getElementById('date-filter-start').value = '';
        document.getElementById('date-filter-end').value = '';
      } else {
        startDate.setDate(startDate.getDate() - days);
        document.getElementById('date-filter-start').value = startDate.toISOString().split('T')[0];
        document.getElementById('date-filter-end').value = endDate.toISOString().split('T')[0];
      }
    }

    // =====================================
    // APPLYING FILTERS
    // =====================================

    function applyFilter(filterType) {
      if (filterType === 'status') {
        filterState.status.values = Array.from(document.querySelectorAll('.status-checkbox:checked'))
          .map(cb => cb.value);
      } else if (filterType === 'type') {
        filterState.type.values = Array.from(document.querySelectorAll('.type-checkbox:checked'))
          .map(cb => cb.value);
      } else if (filterType === 'date') {
        filterState.date.start = document.getElementById('date-filter-start').value || null;
        filterState.date.end = document.getElementById('date-filter-end').value || null;
      } else if (filterType === 'submitter') {
        const selected = document.querySelector('input[name="submitter-radio"]:checked');
        filterState.user_id = selected && selected.value ? selected.value : null;
      }

      closeFilterPanel(filterType);

      // Save to cookie and apply
      CookieManager.set(COOKIE_NAME, filterState, COOKIE_DAYS);
      applyFiltersToUrl();
    }

    function applyFiltersToUrl() {
      const url = new URL(window.location.href);

      // Clear existing filter params (including Rails array format)
      ['status', 'status[]', 'status_mode', 'feedback_type', 'feedback_type[]', 'type_mode', 'date_start', 'date_end', 'user_id'].forEach(p => {
        url.searchParams.delete(p);
      });

      // Add status filter (use Rails array format: status[]=x)
      if (filterState.status.values.length > 0) {
        url.searchParams.set('status_mode', filterState.status.mode);
        filterState.status.values.forEach(v => url.searchParams.append('status[]', v));
      }

      // Add type filter (use Rails array format: feedback_type[]=x)
      if (filterState.type.values.length > 0) {
        url.searchParams.set('type_mode', filterState.type.mode);
        filterState.type.values.forEach(v => url.searchParams.append('feedback_type[]', v));
      }

      // Add date filter
      if (filterState.date.start) {
        url.searchParams.set('date_start', filterState.date.start);
      }
      if (filterState.date.end) {
        url.searchParams.set('date_end', filterState.date.end);
      }

      // Add user filter
      if (filterState.user_id) {
        url.searchParams.set('user_id', filterState.user_id);
      }

      window.location.href = url.toString();
    }

    function removeFilter(filterType) {
      if (filterType === 'status') {
        filterState.status = { mode: 'is', values: [] };
      } else if (filterType === 'type') {
        filterState.type = { mode: 'is', values: [] };
      } else if (filterType === 'date') {
        filterState.date = { start: null, end: null };
      } else if (filterType === 'submitter') {
        filterState.user_id = null;
      }

      CookieManager.set(COOKIE_NAME, filterState, COOKIE_DAYS);
      applyFiltersToUrl();
    }

    function clearAllFilters() {
      filterState = {
        status: { mode: 'is', values: [] },
        type: { mode: 'is', values: [] },
        date: { start: null, end: null },
        user_id: null
      };

      CookieManager.delete(COOKIE_NAME);

      // Redirect to clean URL
      const url = new URL(window.location.href);
      url.search = '';
      window.location.href = url.toString();
    }

    // =====================================
    // UI UPDATES
    // =====================================

    function updateFilterUI() {
      const container = document.getElementById('active-filters');
      const clearBtn = document.getElementById('clear-filters-btn');

      container.innerHTML = '';

      const chips = [];

      // Status chip
      if (filterState.status.values.length > 0) {
        const modeText = filterState.status.mode === 'is_not' ? 'IS NOT' : 'IS';
        const valuesText = filterState.status.values.map(v => v.replace(/_/g, ' ')).join(', ');
        chips.push(createFilterChip('status', `Status ${modeText} ${valuesText}`));
      }

      // Type chip
      if (filterState.type.values.length > 0) {
        const modeText = filterState.type.mode === 'is_not' ? 'IS NOT' : 'IS';
        const valuesText = filterState.type.values.map(v => v.replace(/_/g, ' ')).join(', ');
        chips.push(createFilterChip('type', `Type ${modeText} ${valuesText}`));
      }

      // Date chip
      if (filterState.date.start || filterState.date.end) {
        let dateText = 'Date: ';
        if (filterState.date.start && filterState.date.end) {
          dateText += `${filterState.date.start} to ${filterState.date.end}`;
        } else if (filterState.date.start) {
          dateText += `from ${filterState.date.start}`;
        } else {
          dateText += `until ${filterState.date.end}`;
        }
        chips.push(createFilterChip('date', dateText));
      }

      // Submitter chip
      if (filterState.user_id) {
        const submitterRadio = document.querySelector(`input[name="submitter-radio"][value="${filterState.user_id}"]`);
        const label = submitterRadio?.closest('label')?.textContent?.trim() || `User #${filterState.user_id}`;
        chips.push(createFilterChip('submitter', `Submitter: ${label}`));
      }

      if (chips.length > 0) {
        chips.forEach(chip => container.appendChild(chip));
        container.classList.remove('hidden');
        clearBtn.classList.remove('hidden');
      } else {
        container.classList.add('hidden');
        clearBtn.classList.add('hidden');
      }
    }

    function createFilterChip(filterType, text) {
      const chip = document.createElement('div');
      chip.className = 'badge badge-lg gap-2 bg-blue-100 text-blue-800 border-blue-200';
      chip.innerHTML = `
        <span>${text}</span>
        <button type="button" onclick="removeFilter('${filterType}')" class="hover:text-blue-600">
          <i class="fas fa-times text-xs"></i>
        </button>
      `;
      return chip;
    }

    // Close filter menu when clicking outside
    document.addEventListener('click', (e) => {
      const menu = document.getElementById('filter-menu');
      const btn = document.getElementById('add-filter-btn');
      if (menu && btn && !menu.contains(e.target) && !btn.contains(e.target)) {
        menu.classList.add('hidden');
      }
    });

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initFilters);

    // =====================================
    // RETURN-TO-CARD (scroll restoration)
    // =====================================
    // When the user comes back from a feedback detail page, the "Back to Feedback"
    // button first tries history.back() (browser restores scroll for free). If that
    // isn't possible (deep link, refresh, post-edit redirect) it lands here with
    // #feedback-<id>, and we scroll that card into view and flash it.
    function restoreReturnedCard() {
      const hash = window.location.hash;
      if (!hash || !hash.startsWith('#feedback-')) return;

      const card = document.getElementById(hash.slice(1));
      if (!card) return;

      card.scrollIntoView({ block: 'center', behavior: 'auto' });
      card.classList.add('returned-here');
      setTimeout(() => card.classList.remove('returned-here'), 2000);

      // Drop the hash so a later refresh/filter change doesn't re-trigger the flash.
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }

    document.addEventListener('DOMContentLoaded', restoreReturnedCard);

    // Toast Manager
    class ToastManager {
      constructor() {
        this.container = document.getElementById('toast-container');
        this.toasts = new Map();
      }

      show(message, type = 'success', duration = 3000) {
        const toastId = `toast-${Date.now()}-${Math.random()}`;
        const iconMap = {
          success: '<i class="fas fa-check-circle"></i>',
          error: '<i class="fas fa-exclamation-circle"></i>'
        };
        const icon = iconMap[type] || iconMap.success;
        const existingToasts = this.container.children.length;
        const offset = existingToasts * 8;

        const toastEl = document.createElement('div');
        toastEl.id = toastId;
        toastEl.className = `toast toast-${type} rounded-lg px-5 py-4 text-white flex items-start gap-4 relative overflow-hidden`;
        toastEl.style.cssText = `position: absolute; top: ${offset}px; right: 0; min-width: 280px; z-index: ${1000 + existingToasts};`;
        toastEl.innerHTML = `
          <div class="toast-icon text-lg mt-0.5">${icon}</div>
          <div class="flex-1 text-sm font-medium leading-relaxed">${message}</div>
          <button onclick="toastManager.dismiss('${toastId}')" class="flex-shrink-0 ml-2 hover:opacity-75 transition-opacity p-1 -mr-2">
            <i class="fas fa-times text-lg"></i>
          </button>
          <div class="toast-progress absolute bottom-0 left-0 h-1 bg-white/30" style="animation-duration: ${duration}ms;"></div>
        `;

        this.container.appendChild(toastEl);
        this.toasts.set(toastId, { element: toastEl, timeout: null });
        const timeout = setTimeout(() => this.dismiss(toastId), duration);
        this.toasts.get(toastId).timeout = timeout;
        return toastId;
      }

      dismiss(toastId) {
        const toast = this.toasts.get(toastId);
        if (!toast) return;
        if (toast.timeout) clearTimeout(toast.timeout);
        toast.element.classList.add('exiting');
        setTimeout(() => {
          toast.element.remove();
          this.toasts.delete(toastId);
          this.repositionToasts();
        }, 300);
      }

      repositionToasts() {
        let index = 0;
        this.container.querySelectorAll('.toast:not(.exiting)').forEach(el => {
          el.style.top = `${index * 8}px`;
          el.style.zIndex = 1000 + index;
          index++;
        });
      }
    }

    let toastManager = new ToastManager();
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    // Dropdown state
    let activeFeedbackId = null;
    let activeDropdownType = null;

    // Badge class mappings (mirrors Ruby helpers)
    const badgeClassMaps = {
      status: {
        'open': 'badge-warning',
        'under_review': 'badge-info',
        'acknowledged': 'badge-primary',
        'in_progress': 'badge-accent',
        'resolved': 'badge-success',
        'closed': 'badge-neutral'
      },
      feedback_type: {
        'bug': 'badge-error',
        'suggestion': 'badge-info',
        'question': 'badge-warning',
        'complaint': 'badge-error',
        'praise': 'badge-success',
        'general': 'badge-ghost'
      },
      priority: {
        '0': 'badge-ghost',
        '1': 'badge-info',
        '2': 'badge-warning',
        '3': 'badge-error'
      }
    };

    const iconMaps = {
      status: {
        'open': 'fa-circle-exclamation',
        'under_review': 'fa-magnifying-glass',
        'acknowledged': 'fa-check',
        'in_progress': 'fa-spinner',
        'resolved': 'fa-circle-check',
        'closed': 'fa-lock'
      },
      feedback_type: {
        'bug': 'fa-bug',
        'suggestion': 'fa-lightbulb',
        'question': 'fa-circle-question',
        'complaint': 'fa-triangle-exclamation',
        'praise': 'fa-star',
        'general': 'fa-comment'
      }
    };

    function openFeedbackDropdown(event, feedbackId, dropdownType, currentValue) {
      event.stopPropagation();
      activeFeedbackId = feedbackId;
      activeDropdownType = dropdownType;

      // Close any open dropdowns first
      closeFeedbackDropdowns();

      const selector = document.getElementById(`feedback-${dropdownType}-selector`);
      const rect = event.target.getBoundingClientRect();

      // Position near clicked badge
      selector.style.top = `${rect.bottom + 4}px`;
      selector.style.left = `${rect.left}px`;

      // Highlight current selection
      selector.querySelectorAll('.dropdown-option').forEach(opt => {
        const isSelected = String(opt.dataset.value) === String(currentValue);
        opt.classList.toggle('bg-blue-50', isSelected);
        opt.classList.toggle('text-blue-700', isSelected);
      });

      selector.classList.remove('hidden');

      // Adjust if it goes off-screen
      const selectorRect = selector.getBoundingClientRect();
      if (selectorRect.right > window.innerWidth) {
        selector.style.left = `${window.innerWidth - selectorRect.width - 10}px`;
      }
      if (selectorRect.bottom > window.innerHeight) {
        selector.style.top = `${rect.top - selectorRect.height - 4}px`;
      }
    }

    function closeFeedbackDropdowns() {
      ['status', 'type', 'priority'].forEach(type => {
        const selector = document.getElementById(`feedback-${type}-selector`);
        if (selector) selector.classList.add('hidden');
      });
    }

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.feedback-dropdown') && !e.target.closest('.feedback-badge-clickable')) {
        closeFeedbackDropdowns();
      }
    });

    function handleStatusSelect(value, displayValue) {
      if (activeFeedbackId) {
        updateFeedbackField(activeFeedbackId, 'status', value, displayValue);
        closeFeedbackDropdowns();
      }
    }

    function handleTypeSelect(value, displayValue) {
      if (activeFeedbackId) {
        updateFeedbackField(activeFeedbackId, 'feedback_type', value, displayValue);
        closeFeedbackDropdowns();
      }
    }

    function handlePrioritySelect(value, displayValue) {
      if (activeFeedbackId) {
        updateFeedbackField(activeFeedbackId, 'priority', value, displayValue);
        closeFeedbackDropdowns();
      }
    }

    function updateFeedbackField(feedbackId, field, value, displayValue) {
      fetch(`<%= user_feedbacks_path %>/${feedbackId}.json`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          user_feedback: { [field]: value }
        })
      })
      .then(response => {
        if (!response.ok) throw new Error(`Server returned ${response.status}`);
        return response.json();
      })
      .then(data => {
        updateBadgeDisplay(feedbackId, field, value, displayValue);
        const fieldLabel = field.replace('_', ' ').replace(/\b\w/g, c => c.toUpperCase());
        toastManager.show(`${fieldLabel} updated to <strong>${displayValue}</strong>`, 'success', 2000);
      })
      .catch(error => {
        console.error('Error updating feedback:', error);
        toastManager.show('Failed to update: ' + error.message, 'error', 3000);
      });
    }

    function updateBadgeDisplay(feedbackId, field, value, displayValue) {
      const badgeField = field === 'feedback_type' ? 'feedback_type' : field;
      const badge = document.querySelector(`[data-feedback-badge="${feedbackId}-${badgeField}"]`);
      if (!badge) return;

      // Update text
      const textSpan = badge.querySelector('.badge-text');
      if (textSpan) textSpan.textContent = displayValue;

      // Update badge class
      const mapKey = field === 'feedback_type' ? 'feedback_type' : field;
      const badgeClassMap = badgeClassMaps[mapKey] || {};
      Object.values(badgeClassMaps).forEach(map => {
        Object.values(map).forEach(cls => badge.classList.remove(cls));
      });
      badge.classList.add(badgeClassMap[String(value)] || 'badge-ghost');

      // Update icon (if applicable)
      const iconMap = iconMaps[mapKey];
      if (iconMap) {
        const icon = badge.querySelector('i');
        if (icon && iconMap[String(value)]) {
          icon.className = `fas ${iconMap[String(value)]} mr-1`;
        }
      }
    }

    // Image Modal Functions
    function openImageModal(imageSrc) {
      const modal = document.getElementById('image-modal');
      const modalImage = document.getElementById('modal-image');
      modalImage.src = imageSrc;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeImageModal() {
      const modal = document.getElementById('image-modal');
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    // Close modal on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeImageModal();
    });
  </script>
</body>
</html>
