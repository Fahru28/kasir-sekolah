<%# Shared slide-over detail drawer for LlamaPress scaffold resources.
    Render once near the end of the application layout body:
    render "llama_bot_rails/record_drawer"
    Links opening records into the drawer target the "record_drawer" frame.
    Styles are Tailwind-v2-safe utilities plus llama_bot_rails/scaffold.css. %>
<%= stylesheet_link_tag "llama_bot_rails/scaffold", "data-turbo-track": "reload" %>
<div class="llama-drawer hidden fixed inset-0 z-40"
     data-controller="record-drawer"
     data-action="keydown.esc@window->record-drawer#close turbo:frame-missing->record-drawer#frameMissing"
     role="dialog"
     aria-modal="true"
     aria-label="Record details">
  <div class="llama-drawer-backdrop fixed inset-0 bg-gray-600 bg-opacity-50"
       data-action="click->record-drawer#close"></div>
  <div class="llama-drawer-panel fixed inset-y-0 right-0 w-full sm:max-w-md bg-white shadow-2xl overflow-y-auto">
    <div class="sticky top-0 z-10 flex justify-end bg-white border-b border-gray-100 p-2">
      <button type="button"
              class="p-3 rounded-md text-gray-500 hover:text-gray-800 hover:bg-gray-100"
              data-action="record-drawer#close"
              data-record-drawer-target="closeButton"
              aria-label="Close details">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
    <div class="px-4 py-4 sm:px-6">
      <%= turbo_frame_tag "record_drawer",
            data: {
              record_drawer_target: "frame",
              action: "turbo:frame-load->record-drawer#open"
            } %>
    </div>
  </div>
</div>
